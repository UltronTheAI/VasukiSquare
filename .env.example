# ==========================================
# VasukiSquare
# ==========================================

APP_ENV=development
LOG_LEVEL=INFO

# Groq
GROQ_API_KEY=
GROQ_MODEL=

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vasukisquare

# Search
TAVILY_API_KEY=

# Optional search provider
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Research
RESEARCH_MAX_SOURCES=30
RESEARCH_MAX_PAGES_PER_SOURCE=5

# Generation
DEFAULT_LANGUAGE=en
DEFAULT_TARGET_PAGES=60
DEFAULT_MAX_CHAPTERS=12

# Rendering
PDF_OUTPUT_DIR=./output
TEMP_RENDER_DIR=./.tmp
CHROMIUM_HEADLESS=true

# Cover
COVER_WIDTH=1600
COVER_HEIGHT=2560