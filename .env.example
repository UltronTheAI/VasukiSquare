# ==========================================
# VasukiSquare
# ==========================================

APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider Selection: "auto", "groq", or "ollama"
# "auto": Uses Groq if GROQ_API_KEY is present; otherwise falls back automatically to Ollama
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.25
LLM_FALLBACK_ON_RATE_LIMIT=false

# Groq (Cloud Provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (Local Fallback Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=8192

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vasukisquare

# Search
TAVILY_API_KEY=

# Optional search provider
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Research
RESEARCH_MAX_SOURCES=30
RESEARCH_MAX_PAGES_PER_SOURCE=5

# Generation
DEFAULT_LANGUAGE=en
DEFAULT_TARGET_PAGES=60
DEFAULT_MAX_CHAPTERS=12

# Rendering
PDF_OUTPUT_DIR=./output
TEMP_RENDER_DIR=./.tmp
CHROMIUM_HEADLESS=true

# Cover
COVER_WIDTH=1600
COVER_HEIGHT=2560
COVER_TEMPERATURE=0.8
COVER_VARIATION_ENABLED=true
COVER_MAX_RETRIES=1