# ==========================================
# VasukiSquare
# ==========================================

APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider Selection: "auto", "groq", or "ollama"
# "auto": Uses Groq if GROQ_API_KEY is present; otherwise falls back automatically to Ollama
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.25
LLM_FALLBACK_ON_RATE_LIMIT=false

# Groq (Cloud Provider - Single Model or Model Pool)
GROQ_API_KEY=
# Single model fallback or default:
GROQ_MODEL=openai/gpt-oss-120b

# Model Pool (comma-separated list of Groq models for automatic failover)
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant

# Model Selection Strategy: "ordered" (default), "random", or "rotate"
GROQ_MODEL_STRATEGY=ordered

# Automatic failover between Groq models on rate limit (429), server error (500/503), or model unavailable
GROQ_MODEL_FALLBACK=true

# Retries per model before moving to the next model in the pool
GROQ_RETRIES_PER_MODEL=1

# Maximum models to attempt per generation request (0 = attempt all models in pool)
GROQ_MAX_MODEL_ATTEMPTS=0

# Cooldown time in seconds for a model that encountered rate limits or errors
GROQ_MODEL_COOLDOWN_SECONDS=60

# Optional task-specific model pools (overrides GROQ_MODELS for specific pipeline stages)
# GROQ_MODELS_WRITING=openai/gpt-oss-120b,llama-3.3-70b-versatile
# GROQ_MODELS_RESEARCH=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_MODELS_PLANNING=openai/gpt-oss-120b,llama-3.3-70b-versatile

# Ollama (Local Fallback Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=8192

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vasukisquare

# Search
TAVILY_API_KEY=

# Optional search provider
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Research
RESEARCH_MAX_SOURCES=30
RESEARCH_MAX_PAGES_PER_SOURCE=5

# Generation
DEFAULT_LANGUAGE=en
DEFAULT_TARGET_PAGES=60
DEFAULT_MAX_CHAPTERS=12

# Rendering
PDF_OUTPUT_DIR=./output
TEMP_RENDER_DIR=./.tmp
CHROMIUM_HEADLESS=true

# Cover
COVER_WIDTH=1600
COVER_HEIGHT=2560
COVER_TEMPERATURE=0.8
COVER_VARIATION_ENABLED=true
COVER_MAX_RETRIES=1