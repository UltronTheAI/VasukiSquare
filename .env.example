# ==============================================================================
# VasukiSquare Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# Never commit real credentials, API keys, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: "development", "production", or "test"
APP_ENV=development

# Logging output level: "DEBUG", "INFO", "WARNING", "ERROR"
LOG_LEVEL=INFO

# Set to "true" to force deterministic offline mock mode (no live LLM or web search)
VASUKISQUARE_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 2. LLM PROVIDER & ROUTING
# ------------------------------------------------------------------------------
# Active LLM Provider:
#   "auto"   - Automatically uses Groq if GROQ_API_KEY is configured; otherwise uses Ollama
#   "groq"   - Force Groq cloud provider (requires GROQ_API_KEY)
#   "ollama" - Force Ollama local provider (requires local Ollama server running)
LLM_PROVIDER=auto

# Sampling temperature for LLM text and structured JSON generation (0.0 to 1.0)
LLM_TEMPERATURE=0.25

# Fall back from Groq to Ollama if all Groq keys/models are rate-limited or exhausted
LLM_FALLBACK_ON_RATE_LIMIT=false

# Small Model Mode ("auto", "true", "false"): Optimize prompts/schemas for smaller parameter models (<7B)
SMALL_MODEL_MODE=auto

# ------------------------------------------------------------------------------
# 3. GROQ CLOUD LLM PROVIDER (High-Speed Inference)
# ------------------------------------------------------------------------------
# Groq API Key(s): Single key or comma-separated list of keys for automatic rotation
# Example: GROQ_API_KEY=gsk_key1,gsk_key2
GROQ_API_KEY=

# Groq API Key Selection Strategy:
#   "preferred"   - Always use Key #1 first, falling over to Key #2 upon rate limit
#   "round_robin" - Distribute requests evenly across configured keys
#   "rotate"      - Rotate to next key on each logical request
GROQ_KEY_STRATEGY=preferred

# Cooldown time in seconds for an API key that encounters rate limits (HTTP 429)
GROQ_KEY_COOLDOWN_SECONDS=60.0

# Default single Groq model
GROQ_MODEL=openai/gpt-oss-120b

# Model Pool: Comma-separated list of Groq models for automatic failover
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant

# Model Selection Strategy: "ordered" (default), "random", or "rotate"
GROQ_MODEL_STRATEGY=ordered

# Automatic failover between Groq models on rate limit (429) or server error (500/503)
GROQ_MODEL_FALLBACK=true

# Retries per model before moving to the next model in the pool
GROQ_RETRIES_PER_MODEL=1

# Maximum models to attempt per generation request (0 = attempt all models in pool)
GROQ_MAX_MODEL_ATTEMPTS=0

# Cooldown time in seconds for a model that encountered rate limits or server errors
GROQ_MODEL_COOLDOWN_SECONDS=60.0

# Wait for earliest model/key cooldown before failing when all candidates are rate-limited
GROQ_WAIT_FOR_RATE_LIMIT=true
GROQ_MAX_RATE_LIMIT_WAIT_SECONDS=60.0
GROQ_RATE_LIMIT_BUFFER_SECONDS=1.0

# Optional task-specific model pools (overrides GROQ_MODELS for specific pipeline stages)
# GROQ_MODELS_WRITING=openai/gpt-oss-120b,llama-3.3-70b-versatile
# GROQ_MODELS_RESEARCH=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_MODELS_PLANNING=openai/gpt-oss-120b,llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. OLLAMA LOCAL LLM PROVIDER (Zero Cost / Offline Capable)
# ------------------------------------------------------------------------------
# Ollama server base URL
OLLAMA_BASE_URL=http://localhost:11434

# Recommended Ollama models: "qwen2.5:7b-instruct", "llama3.1:8b", "mistral:7b"
OLLAMA_MODEL=qwen2.5:7b-instruct

# Context window size in tokens
OLLAMA_NUM_CTX=8192

# ------------------------------------------------------------------------------
# 5. WEB SEARCH & RESEARCH PROVIDERS
# ------------------------------------------------------------------------------
# Search Provider Selection:
#   "auto"        - Uses SearXNG if running, then Tavily/Serper/Brave if configured, then DuckDuckGo
#   "duckduckgo"  - Free HTML web search (zero API keys required)
#   "searxng"     - Local self-hosted SearXNG metasearch instance
#   "tavily"      - Tavily AI search API
#   "serper"      - Serper Google search API
#   "brave"       - Brave Search API
#   "mock"        - Built-in deterministic technical documentation corpus
SEARCH_PROVIDER=auto

# SearXNG Local Metasearch (Self-Hosted)
SEARXNG_URL=http://localhost:8080
SEARXNG_ENABLED=true
SEARXNG_TIMEOUT=20.0
SEARXNG_MAX_RESULTS=10

# Commercial Search API Keys (Optional)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Research limits
RESEARCH_MAX_SOURCES=30
RESEARCH_MAX_PAGES_PER_SOURCE=5
MIN_RESEARCH_SOURCES=3

# ------------------------------------------------------------------------------
# 6. EBOOK GENERATION DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_LANGUAGE=en
DEFAULT_TARGET_PAGES=60
DEFAULT_MAX_CHAPTERS=12

# ------------------------------------------------------------------------------
# 7. RENDERING & PDF EXPORT
# ------------------------------------------------------------------------------
PDF_OUTPUT_DIR=./output
TEMP_RENDER_DIR=./.tmp
CHROMIUM_HEADLESS=true

# ------------------------------------------------------------------------------
# 8. COVER ARTWORK CONFIGURATION
# ------------------------------------------------------------------------------
COVER_WIDTH=1600
COVER_HEIGHT=2560
COVER_TEMPERATURE=0.8
COVER_VARIATION_ENABLED=true
COVER_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# 9. DATABASE PERSISTENCE (MongoDB Storage)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vasukisquare
IDEA_COLLECTION=book_ideas
BOOK_COLLECTION=books

# ------------------------------------------------------------------------------
# 10. AUTOMATED BOOK IDEA RESEARCH & QUEUE
# ------------------------------------------------------------------------------
RESEARCH_IDEA_COUNT=5
RESEARCH_MIN_SCORE=0.70
IDEA_PROCESSING_TIMEOUT_MINUTES=180
IDEA_MAX_ATTEMPTS=3